{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    {
      "type": "command",
      "text": "dpkg -l | wc -l",
      "key": "Native (dpkg)"
    },
    {
      "type": "command",
      "text": "echo $(( $(brew list --cask | wc -l) + $(brew list | wc -l) ))",
      "key": "Homebrew (brew)"
    },
    {
      "type": "command",
      "text": "flatpak list | wc -l",
      "key": "Flathub (flatpak)"
    },
    "break",
    "colors"
  ]
}
